{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SportsStore;Trusted_Connection=True"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "SuccessUrl": "http://localhost:5000/Payment/Success",
    "CancelUrl": "http://localhost:5000/Payment/Cancel"
  },

  "AllowedHosts": "*"
}