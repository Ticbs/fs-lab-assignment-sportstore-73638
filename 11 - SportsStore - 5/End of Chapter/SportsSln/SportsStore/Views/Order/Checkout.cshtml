@model Order

@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout</h2>
<p>Please enter your details, and we'll ship your goods right away!</p>

@if (TempData["StripeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["StripeError"]
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Checkout" method="post">
    <h3>Ship to</h3>

    <div class="form-group mb-2">
        <label asp-for="Name">Name:</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <h3>Address</h3>

    <div class="form-group mb-2">
        <label asp-for="Line1">Address Line 1:</label>
        <input asp-for="Line1" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Line2">Address Line 2:</label>
        <input asp-for="Line2" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Line3">Address Line 3:</label>
        <input asp-for="Line3" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="City">City:</label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="State">State:</label>
        <input asp-for="State" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Zip">Zip:</label>
        <input asp-for="Zip" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Country">Country:</label>
        <input asp-for="Country" class="form-control" />
    </div>

    <h3>Options</h3>

    <div class="form-check mb-3">
        <input asp-for="GiftWrap" class="form-check-input" />
        <label asp-for="GiftWrap" class="form-check-label">Gift wrap these items</label>
    </div>

    <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary">Complete Order Without Stripe</button>
        <a asp-controller="Payment" asp-action="Checkout" class="btn btn-success ms-2">
            Pay with Stripe
        </a>
    </div>
</form>